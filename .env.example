# Lámsza Admin — every variable the code reads.
#
# One file serves both halves: the Go backend loads it directly
# (backend/internal/config/config.go reads ../.env then ./.env), and the
# frontend picks up the VITE_* names through `envDir: '..'` in
# frontend/vite.config.js. Copy to `.env` and fill in the blanks.
#
# VITE_* values are baked in at BUILD time, not read at runtime — set them
# before `npm run build`, not after.
#
# Nothing here is a secret. Never commit a real key into this file.

# --- Backend ---------------------------------------------------------------

PORT=3000
DATABASE_URL=postgres://lamsza_user:lamsza_password@localhost:5433/lamsza?sslmode=disable

# The Google OAuth web client this app signs in with. Its authorized JS origins
# must include http://localhost:5173 (and http://127.0.0.1:5173) for dev, and
# https://admin.lamsza.com for production. (On 2026-10-07 the local .env used a
# different client id than lamsza's; either works if its origins are right.)
GOOGLE_CLIENT_ID=
# Comma-separated accounts allowed into the admin. When unset it falls back to
# the owner's address (internal/config/config.go); set it explicitly anywhere else.
ADMIN_GOOGLE_EMAILS=

# Exact browser origins that may call this API cross-origin, comma-separated.
# Empty = use the built-in list (the four *.lamsza.com sites plus the
# *.lamsza.test and localhost dev hosts). A value REPLACES that list, so set it
# in production to drop the dev hosts:
#   CORS_ALLOWED_ORIGINS=https://admin.lamsza.com
# See docs/ARCHITECTURE.md, "Cross-origin calls (CORS)".
CORS_ALLOWED_ORIGINS=

# The /dictionary and /games sections reach Szótár's and Játszótér's internal
# admin APIs through this backend (lamsza WAYS_OF_WORKING R18), server-to-server
# on 127.0.0.1. Each token must equal ADMIN_SERVICE_TOKEN in that app's .env.
# A missing token turns that section off (503). See docs/ARCHITECTURE.md, "The
# relay to Szótár and Játszótér".
SZOTAR_ADMIN_URL=http://127.0.0.1:3002
SZOTAR_ADMIN_TOKEN=
JATSZOTER_ADMIN_URL=http://127.0.0.1:3003
JATSZOTER_ADMIN_TOKEN=

# Shared media dirs with the main lamsza backend (absolute paths recommended)
ENTRY_IMAGES_DIR=/home/attila/projects/lamsza-network/lamsza/backend/data/entry-images
EVENT_IMAGES_DIR=/home/attila/projects/lamsza-network/lamsza/backend/data/event-images

# Weather providers, read by internal/weather. Both are optional — the lookup
# falls through to Open-Meteo, which needs no key.
WEATHER_API_KEY=
WEATHER_API_COM_KEY=

# Route groups in main.go. Anything other than `true` disables the group.
FEATURE_WEATHER=true
FEATURE_EVENTS=true
FEATURE_NEWS=true
FEATURE_MONDASOK=true
FEATURE_QUICKLINKS=true

# --- Frontend (build-time) -------------------------------------------------

# API origin for SSR/prerender only. Leave it empty in normal use: in the
# browser src/lib/api.js resolves to window.location.origin, so the Vite dev
# proxy and the production reverse proxy both work without it.
VITE_API_BASE_URL=

# Link from the admin sidebar back to the public site.
VITE_LAMSZA_ORIGIN=http://localhost:5174

# Header app switcher (src/lib/adminApps.js). Szótár and Játszótér still keep
# their admin UI at /admin inside their own app, so those two are full URLs,
# not bare origins. A blank value falls back to the local dev port, so a
# production build must set all three or it ships localhost links.
VITE_ADMIN_ORIGIN=http://localhost:5173
VITE_SZOTAR_ADMIN_ORIGIN=http://localhost:5175/admin
VITE_JATSZOTER_ADMIN_ORIGIN=http://localhost:5176/admin
