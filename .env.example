PORT=3000
DATABASE_URL=postgres://lamsza_user:lamsza_password@localhost:5433/lamsza?sslmode=disable

# Same Google OAuth client as main Lámsza.
# Authorized JS origins must include http://localhost:5173 (and http://127.0.0.1:5173)
GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_EMAILS=

# Link to main site from admin sidebar
VITE_LAMSZA_ORIGIN=http://localhost:5174

# Shared media dirs with main lamsza backend (absolute paths recommended)
ENTRY_IMAGES_DIR=/home/attila/projects/lamsza/backend/data/entry-images
EVENT_IMAGES_DIR=/home/attila/projects/lamsza/backend/data/event-images

FEATURE_WEATHER=true
FEATURE_EVENTS=true
FEATURE_NEWS=true
FEATURE_MONDASOK=true
FEATURE_QUICKLINKS=true
FEATURE_SEARCH=false
DATA_API=true
